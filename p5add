 ID DIVISION.
 PROGRAM-ID.    P5ADD.
 ENVIRONMENT DIVISION.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
      COPY DFHBMSCA.
      COPY DFHAID.
      COPY MS3ADD.
        
 77 WS-TEMPS      PIC S9(15) COMP-3.
 77 WS-CD-ERR     PIC S9(8)  COMP.
 77 WS-ERR-MESS   PIC X(50)  VALUE 'BYE !'.
   
 01 ENR-PART.
    05 PA-PNO      PIC XX.
    05 PA-PNAME    PIC X(30).
    05 PA-COLOR    PIC X(20).
    05 PA-WEIGHT   PIC X(02).
    05 PA-CITY     PIC X(20).
    05 FILLER      PIC X(06).
      
 01 ZONE.
    05 PGM-CURR    PIC X(08) VALUE 'P5ADD'.
    05 TRN-CURR    PIC X(04) VALUE 'T3AJ'.
    05 CO-USER     PIC X(02).
    05 RES-CH      PIC X(56).
      
 LINKAGE SECTION.
 01 DFHCOMMAREA   PIC X(70).
   
 PROCEDURE DIVISION USING DFHCOMMAREA.
       EVALUATE EIBTRNID
        WHEN 'T3AJ'
           IF EIBCALEN = ZERO
              MOVE 'ACCES INTERDIT - AUTHENTIFIEZ VOUS'
                 TO WS-ERR-MESS
              PERFORM FIN-TOTALE
           ELSE
              MOVE DFHCOMMAREA TO ZONE
              PERFORM TRAIT-CONVERSATION
           END-IF
        WHEN OTHER
           CONTINUE
       END-EVALUATE
        
       PERFORM ENVOI-ECRAN.

 TRAIT-CONVERSATION.
       EVALUATE EIBAID
         WHEN DFHENTER
            PERFORM LECT-ECRAN
            PERFORM TRT-AJOUT
         WHEN DFHPF3
            PERFORM RETOUR-LOGIN
         WHEN OTHER
            MOVE LOW-VALUE TO MAP3ADDO
            MOVE 'TOUCHE INVALIDE !' TO MESS1O
            MOVE DFHPINK TO MESS1C
       END-EVALUATE.
        
 ENVOI-ECRAN.
* CONSTITUTION ENTETE
     MOVE EIBTRNID  TO TRNNAMEO
     MOVE PGM-CURR  TO PGMNAMEO
     MOVE CO-USER   TO USERCOO
     EXEC CICS    ASKTIME ABSTIME(WS-TEMPS)    END-EXEC
     EXEC CICS
           FORMATTIME ABSTIME (WS-TEMPS)
           DDMMYY (DATEJO)
           DATESEP ('/')
           TIME (HEUREO)
           TIMESEP (':')
     END-EXEC
      
* ENVOI DE LA MAP A AFFICHER
     EXEC CICS
           SEND MAP ('MAP3ADD')
           MAPSET ('MS3ADD')
           RESP (WS-CD-ERR)
           ERASE
           CURSOR
           WAIT
     END-EXEC
      
     IF WS-CD-ERR NOT EQUAL DFHRESP(NORMAL)
        MOVE 'ERR SEND'  TO WS-ERR-MESS
        PERFORM FIN-TOTALE
     END-IF
     
     EXEC CICS
          RETURN TRANSID ('T3AJ')
          COMMAREA (ZONE)
          LENGTH (LENGTH OF ZONE)
     END-EXEC.
       
 LECT-ECRAN.
     EXEC CICS
           RECEIVE MAP ('MAP3ADD')
           MAPSET ('MS3ADD')
           RESP (WS-CD-ERR)
     END-EXEC
     IF WS-CD-ERR NOT EQUAL DFHRESP(NORMAL)
        MOVE 'ERR RECEIVE'  TO WS-ERR-MESS
        PERFORM FIN-TOTALE
     END-IF.
      
 TRT-AJOUT.
     IF PNOI IS NOT EQUAL TO SPACE AND LOW-VALUE
        PERFORM PREP-ENR
        EXEC CICS
            WRITE DATASET ('PARTS3')
            RIDFLD (PA-PNO)
            FROM (ENR-PART)
            RESP (WS-CD-ERR)
        END-EXEC
        EVALUATE WS-CD-ERR
           WHEN ZERO
              MOVE 'PIECE AJOUTEE !' TO MESS1O
              MOVE DFHGREEN TO MESS1C
           WHEN DFHRESP(DUPREC)
              MOVE 'PIECE DEJA EXISTANTE !' TO MESS1O
              MOVE DFHRED TO MESS1C
           WHEN OTHER
              MOVE 'ERR WRITE PARTS3 !' TO MESS1O
              MOVE DFHRED TO MESS1C
        END-EVALUATE
     ELSE
        MOVE 'NUMERO DE PIECE MANQUANT !' TO MESS1O
        MOVE DFHRED TO MESS1C
     END-IF.
       
 PREP-ENR.
     INSPECT PNOI    REPLACING ALL '_' BY ' '
     INSPECT PNAMEI  REPLACING ALL '_' BY ' '
     INSPECT COLORPI REPLACING ALL '_' BY ' '
     INSPECT WEIGHTPI REPLACING ALL '_' BY ' '
     INSPECT CITYPI  REPLACING ALL '_' BY ' '
     MOVE PNOI    TO PA-PNO
     MOVE PNAMEI  TO PA-PNAME
     MOVE COLORPI TO PA-COLOR
     MOVE WEIGHTPI TO PA-WEIGHT
     MOVE CITYPI  TO PA-CITY
     MOVE SPACES  TO FILLER OF ENR-PART.
       
 RETOUR-LOGIN.
     EXEC CICS
           XCTL PROGRAM ('P5LOG')
           RESP (WS-CD-ERR)
     END-EXEC
     IF WS-CD-ERR NOT EQUAL DFHRESP(NORMAL)
        MOVE 'ERR XCTL P5LOG'  TO WS-ERR-MESS
        PERFORM FIN-TOTALE
     END-IF.
       
 FIN-TOTALE.
     EXEC CICS
           SEND FROM (WS-ERR-MESS)
           LENGTH (LENGTH OF WS-ERR-MESS)
           RESP (WS-CD-ERR)
           ERASE
           WAIT
     END-EXEC
     EXEC CICS    RETURN   END-EXEC.
      